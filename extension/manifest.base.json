{
  "manifest_version": 3,
  "name": "RER Reader",
  "version": "0.0.0",
  "description": "Reader cache-first avec buffer adaptatif, reprise de lecture et auto-scroll pour comics et novels.",
  "homepage_url": "https://github.com/Kiwinokoto/monkey",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
